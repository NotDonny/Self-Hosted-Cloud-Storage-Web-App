# Copy this file to .env and fill in real values before running the app.
# Generate secrets with:  python -c "import secrets; print(secrets.token_hex(32))"

SECRET_KEY=replace-with-a-random-secret
JWT_SECRET_KEY=replace-with-another-random-secret

# Set to 'production' when deploying behind HTTPS
FLASK_ENV=development
FLASK_DEBUG=false

# Frontend origin for CORS — no trailing slash
FRONTEND_ORIGIN=http://localhost:5173

# ── Password reset email (SMTP) ───────────────────────────────────────────────
# Leave blank in development — the reset link will be printed to the server log.
# For Gmail: enable 2FA, create an App Password, use port 587.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
APP_NAME=CloudDrive
