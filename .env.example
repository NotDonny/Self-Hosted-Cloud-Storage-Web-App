# Copy this file to .env and fill in your values

# Secrets — generate long random strings (e.g. `openssl rand -hex 32`)
SECRET_KEY=change-me-to-a-long-random-string
JWT_SECRET_KEY=change-me-to-another-long-random-string

# CORS — the public URL where the frontend is served
FRONTEND_ORIGIN=http://localhost

# SMTP — for password reset / email features
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=you@gmail.com
